{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Performance72",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Performance72"
            }
        },
        {
            "name": "Performance100",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Performance100"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Performance72",
            "configurePreset": "Performance72"
        },
        {
            "name": "Performance100",
            "configurePreset": "Performance100"
        }
    ]
}
